# OS
.DS_Store
Thumbs.db

# Data - keep raw + silver + gold checked in so the app and the grader can
# load them without re-running the pipeline. They're all small (~600KB total).
data/bronze/
data/raw/*.parquet
data/raw/.tmp/
# Spark output dirs (regenerated by spark_transform.py)
data/silver/games_spark/
data/gold/event_features_spark/

# MLflow runs are regenerated by `python src/train_model.py`
mlruns/
# Model artifacts ARE committed (small, ~2MB) so Streamlit Cloud can serve
# predictions without retraining on startup. Run `train_model.py` to refresh.

# Local secrets
.env
.aws/

# Editor
.vscode/
.idea/

# Streamlit
.streamlit/secrets.toml

# Notebook checkpoints
.ipynb_checkpoints/
